#Ques 1. Write a program to read the entire content from a txt file and display it to the user.
Code:

file = open("sample.txt", "r")
content = file.read()
print(content)
file.close()

#Ques 2. Write a program to read first n lines from a txt file. Get n as user input.
Code:

n = int(input("Enter number of lines: "))
file = open("sample.txt", "r")
for i in range(n):
    line = file.readline()
    if line == "":
        break
    print(line, end="")
file.close()

#Ques 3. Write a program to accept input from user and append it to a txt file.
Code:

text = input("Enter text: ")
file = open("sample.txt", "a")
file.write(text + "\n")
file.close()
print("Data appended successfully.")

